@page "/"
@using Cinemax.Shared.Contracts.Movies
@using Cinemax.Client.Pages.Shared

@inject HttpClient _httpClient
@inject IJSRuntime JS;

<PageTitle>Home</PageTitle>
<div class="col-12 movies-container">
    <h2>@CommonL["Txt_OnScreen"]</h2>
    @if (_moviesOnScreen.Count() > 0)
    {
        <Swiper Id="on-screen-swiper"
                Class="movie-swiper"
                TItem="MovieDisplayCardDto"
                Items="@_moviesOnScreen"
                GetUrl="@(m => $"/movies/{m.Id.ToString()}")"
                GetTitle="m => m.Title"
                GetImageUrl="m => m.PosterUrl" />
    }
    else
    {
        <p class="text-muted align-center text-center fs-5">@CommonL["Info_NoMoviesOnScreen"]</p>
    }
    <h2>@CommonL["Txt_Soon"]</h2>
    @if(_moviesComingSoon.Count() > 0)
    {
        <Swiper Id="coming-soon-swiper"
                Class="movie-swiper"
                TItem="MovieDisplayCardDto"
                Items="@_moviesComingSoon"
                GetUrl="@(m => $"/movies/{m.Id.ToString()}")"
                GetTitle="m => m.Title"
                GetImageUrl="m => m.PosterUrl" />
    }
    else
    {
        <p class="text-muted align-center text-center fs-5">@CommonL["Info_NoMoviesSoon"]</p>
    }
</div>

@code{
    private IEnumerable<MovieDisplayCardDto> _moviesOnScreen = [];
    private IEnumerable<MovieDisplayCardDto> _moviesComingSoon = [];

    private string? _errorMessage;
    private IEnumerable<string> _errors = [];
    private bool _isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await GetMovies();
    }

    private async Task GetMovies()
    {
        _isLoading = true;
        try
        {
            var response = await _httpClient.GetAndReadAsync<GetMovieCarouselsResponse>("api/movies/highlights");

            if (response.IsSuccess)
            {

                var data = response.Data!;

                _moviesOnScreen = data.MoviesOnScreen;
                _moviesComingSoon = data.MoviesComingSoon;
            }else
            {
                _errorMessage = response.ErrorMessage;
                _errors = response.Errors;
            }
        }
        finally
        {
            _isLoading = false;
        }
    }
}
