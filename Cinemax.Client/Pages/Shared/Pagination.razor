
<div class="pagination mt-5 justify-content-center">
    <nav>
        <ul class="pagination mb-0">
            <li class="page-item">
                <a class="btn btn-page @(_isPreviousPageAvailable ? "" : "disabled-link")" href="/movies?page=1">|<i class="bi bi-caret-left-fill"></i></a>
            </li>

            <li class="page-item">
                <a class="btn btn-page @(_isPreviousPageAvailable ? "" : "disabled-link")" href="@($"{Url}?page={Page - 1}")"><i class="bi bi-caret-left-fill"></i></a>
            </li>
            @for (var i = 0; i < 5; i++)
            {
                var pageItem = _firstPage + i;
                if (pageItem <= TotalPages)
                {
                    <li class="page-item">
                        <a class="btn btn-page @(pageItem == Page ? "active" : "")" href="@($"{Url}?page={pageItem}")">
                            @pageItem
                        </a>
                    </li>
                }
            }

            <li class="page-item">
                <a class="btn btn-page @(_isNextPageAvailable ? "" : "disabled-link")" href="@($"{Url}?page={Page + 1}")"><i class="bi bi-caret-right-fill"></i></a>
            </li>

            <li class="page-item">
                <a class="btn btn-page @(_isNextPageAvailable ? "" : "disabled-link")" href="@($"{Url}?page={TotalPages}")"><i class="bi bi-caret-right-fill"></i>|</a>
            </li>
        </ul>
    </nav>
</div>

@code {
    [Parameter]
    [EditorRequired]
    public int Page { get; set; }

    [Parameter]
    [EditorRequired]
    public int TotalPages { get; set; }

    [Parameter]
    [EditorRequired]
    public string Url { get; set; }

    private bool _isNextPageAvailable => Page + 1 <= TotalPages;
    private bool _isPreviousPageAvailable => Page - 1 >= 1;
    private int _firstPage => Page < 3 ? 1 : Page - 2;

}
