@typeparam TItem
@attribute [CascadingTypeParameter(nameof(TItem))]

<CascadingValue Value="this">
    @GridColumns
</CascadingValue>


<table class="table table-bordered table-striped table-hover">
    <thead>
        @if (GridToolbar is not null)
        {
            <tr>
                <td class="table-tollbar table-toolbar-dark" colspan=" @_columnsCount">
                    @GridToolbar
                </td>
            </tr>
        }
        <tr>
            @if (_columnsCount > 0)
            {
                @foreach (var column in _columns)
                {
                    <th>@column.Title</th>
                }
                @if (GridRowActions is not null)
                {
                    <th></th>
                }
            }
        </tr>
    </thead>
    <tbody>
        <Loader IsLoading="@_isLoading" />
        @if (Items.Count() > 0)
        {
            @foreach (var item in Items)
            {
                <tr>
                    @foreach (var column in _columns)
                    {
                        <td>@column.GetValue(item)</td>
                    }
                    @if (GridRowActions is not null)
                    {
                        <td class="table-row-actions">@GridRowActions(item)</td>
                    }
                </tr>
            }
        }
        else
        {
            <tr>
                <td class="text-center" colspan="@_columnsCount">@CommonL["Txt_NoData"]</td>
            </tr>
        }
    </tbody>
    <tfoot class="table-foot-dark">
        <tr>
            <td colspan="@_columnsCount">
                <div class="d-flex justify-content-between align-items-center">
                    <nav>
                        <ul class="pagination mb-0">
                            <li class="page-item @(_isPreviousPageAvailable ? "" : "disabled")">
                                <button class="page-link" @onclick="PreviousPage">
                                    @CommonL["Btn_Previous"]
                                </button>
                            </li>

                            <li class="page-item disabled">
                                <span class="page-link">
                                    @_pageNumber / @TotalPages
                                </span>
                            </li>

                            <li class="page-item @(_isNextPageAvailable ? "" : "disabled")">
                                <button class="page-link" @onclick="NextPage">
                                    @CommonL["Btn_Next"]
                                </button>
                            </li>
                        </ul>
                    </nav>

                    <div class="text-muted">
                        @_recordsRange
                    </div>
                </div>
            </td>
        </tr>
    </tfoot>
</table>

@code{
    private readonly List<GridColumn<TItem>> _columns = [];
    [Parameter] public IEnumerable<TItem> Items { get; set; } = [];
    [Parameter] public RenderFragment? GridToolbar { get; set; }
    [Parameter] public RenderFragment? GridColumns { get; set; }
    [Parameter] public RenderFragment<TItem>? GridRowActions { get; set; }
    [Parameter]
    public required Func<GridRequest, Task<GridResponse<TItem>>> LoadData { get; set; }

    private int _columnsCount => _columns.Count + (GridRowActions is not null ? 1 : 0);
    private int _pageNumber = 1;
    private int _pageSize = 10;
    private int _totalCount;

    private int _recordsSkipped => ((_pageNumber - 1) * _pageSize);
    private string _recordsFrom => _totalCount > 0 ? $"{_recordsSkipped + 1} - " : "";
    private string _recordsRange => $"{_recordsFrom}{_recordsSkipped + Items.Count()} z {_totalCount} rekordów";

    private bool _isPreviousPageAvailable => _pageNumber > 1;
    private bool _isNextPageAvailable => _pageNumber < TotalPages;

    private bool _isLoading { get; set; } = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadPageAsync();
    }

    public async Task ReloadAsync()
    {
        _pageNumber = 1;
        await LoadPageAsync();
    }

    public void AddColumn(GridColumn<TItem> column)
    {
        _columns.Add(column);
    }

    private async Task LoadPageAsync()
    {
        _isLoading = true;
        var result = await LoadData(new GridRequest
        {
            PageNumber = _pageNumber,
            PageSize = _pageSize
        });

        Items = result.Items;
        _totalCount = result.TotalCount;
        _isLoading = false;
    }

    private int TotalPages =>
        _totalCount == 0
            ? 1
            : (int)Math.Ceiling((double)_totalCount / _pageSize);


    private async Task PreviousPage()
    {
        if (!_isPreviousPageAvailable)
            return;

        _pageNumber--;
        await LoadPageAsync();
    }

    private async Task NextPage()
    {
        if (!_isNextPageAvailable)
            return;

        _pageNumber++;
        await LoadPageAsync();
    }

    private async Task OnPageSizeChanged()
    {
        _pageNumber = 1;
        await LoadPageAsync();
    }
}
