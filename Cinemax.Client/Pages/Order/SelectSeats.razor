@using Cinemax.Shared.Contracts.Scrennings
@using Cinemax.Shared.Contracts.Seats
@using Cinemax.Shared.Enums

<div id="cinema-hall-seats">
    <div id="screen">
        <div class="screen-shape">
            <span id="cinemahall-number">@CommonL["Txt_CinemaHall"] @CinemaHallNumber</span>
        </div>
    </div>
    <div id="seats">
        @foreach (var row in SeatsRows)
        {
            <div class="seats-row">
                <div>@row.Row</div>
                <div class="seats">
                    @foreach (var seat in row.Seats)
                    {
                        <div class="seat @(seat.Type.Equals(SeatType.Couch) ? "sofa" : "") @(GetSeatStatusClass(seat))"
                             @onclick="() => SelectSeat(seat)">
                            @seat.Number
                        </div>
                    }
                </div>
                <div>@row.Row</div>
            </div>
        }
    </div>
    <div id="summary">
        <div id="selected-seats">
            @foreach (var row in SelectedSeats.GroupBy(s => s.Row).OrderBy(g => g.Key))
            {
                <div class="row justify-content-center">
                    <div class="col-md-3 fw-bold text-end">@CommonL["Txt_Row"] @row.Key: </div>
                    <div class="col-md-3 fw-bold text-start">
                        @string.Join(", ", row.OrderBy(s => s.Number).Select(s => s.Number))
                    </div>
                </div>
            }
        </div>
        <div class="row justify-content-center">
            <div class="col-md-3">
                <a class="btn btn-cancel" href="/"><i class="bi bi-caret-left-fill"></i>@CommonL["Btn_Cancel"]</a>
            </div>
            <div class="col-md-3">
                <button class="btn btn-next" disabled="@(!(SelectedSeats.Count > 0))" @onclick="ConfirmSeats">@CommonL["Btn_ConfirmSeats"]</button>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public int CinemaHallNumber { get; set; }
    [Parameter] public IEnumerable<ScreeningSeatsRowDto> SeatsRows { get; set; } = [];
    [Parameter] public List<ScreeningSeatDto> SelectedSeats { get; set; } = [];
    [Parameter] public EventCallback ConfirmSeats { get; set; }


    private void SelectSeat(ScreeningSeatDto seat)
    {
        if (seat.Status != ScreeningSeatStatus.Available)
            return;

        if (SelectedSeats.Contains(seat))
        {
            SelectedSeats.Remove(seat);
            return;
        }

        SelectedSeats.Add(seat);
    }

    private string GetSeatStatusClass(ScreeningSeatDto seat)
    {
        if (SelectedSeats.Contains(seat))
            return "selected";

        return seat.Status switch
        {
            ScreeningSeatStatus.Booked => "booked",
            ScreeningSeatStatus.Sold => "sold",
            _ => "available"
        };
    }
}
