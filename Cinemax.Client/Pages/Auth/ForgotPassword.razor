@page "/forgot-password"

@using System.ComponentModel.DataAnnotations
@using Cinemax.Client.Pages.Shared
@using Cinemax.Shared.Contracts.Identity
@using Cinemax.Shared.Resources.Auth
@using Cinemax.Shared.Resources.Validation

@inject HttpClient _httpClient
@inject IStringLocalizer<AuthMessages> AuthL

<Cinemax.Client.Pages.Shared.Loader IsLoading="_isLoading"/>
<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <EditForm Enhance Model="_model" OnValidSubmit="@OnValidHandle">
                <DataAnnotationsValidator />
                <div class="card">
                    <div class="card-header">@AuthL["Title_ForgotPassword"]</div>
                    <div class="card-body">
                        @if (_isSubmitted)
                        {
                            <FormAlert Title="Zgłoszenie wysłane"
                                       Message="Na podany adres email zostanie wysłana wiadomość z wygenerowanym linkiem do zmiany hasła."
                                       Type="AlertType.Success" />
                        }
                        else{
                            <div class="form-group mt-3">
                                <label class="form-label">@AuthL["Label_Email"]:</label>
                                <InputText id="email-input" @bind-Value="_model.Email" class="form-control"></InputText>
                                <div id="email-validation" class="alert-danger">
                                    <ValidationMessage For="@(() => _model.Email)" />
                                </div>
                            </div>
                            <div class="form-group mt-3">
                                <button id="login-submit-button" class="btn btn-outline-primary float-end" type="submit">@CommonL["Btn_Submit"]</button>
                            </div>
                        }
                    </div>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private GenerateResetPasswordNotificationModel _model = new();

    private bool _isLoading = false;
    private bool _isSubmitted = false;

    public async Task OnValidHandle()
    {
        _isLoading = true;

        try
        {
            var request = new GenerateResetPasswordNotificationRequest
            {
                Email = _model.Email
            };
            await _httpClient.PostAndReadAsync($"api/Account/generate-reset-password-notification", request);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private class GenerateResetPasswordNotificationModel
    {
        [Required(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.Required_Email))]
        [EmailAddress(ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.EmailAddress))]
        [MaxLength(320, ErrorMessageResourceType = typeof(ValidationMessages), ErrorMessageResourceName = nameof(ValidationMessages.MaxLength_Email))]
        public string Email { get; set; } = string.Empty;
    }
}
