@using Cinemax.Client.Pages.Shared.AdminPanel
@using Cinemax.Client.Services
@using Cinemax.Shared.Contracts.Genres

@page "/admin/genres"
@attribute [Authorize(Roles = "Admin")]
@layout AdminPanelLayout

@inject HttpClient _httpClient
@inject NotificationService _notificationService

<AdminContentCard Title="@CommonL["Txt_Genres"]">
    <CardBody>
        <DataGrid @ref="_genresGrid" TItem="GenreDto" LoadData="@LoadData">
            <GridToolbar>
                <GridButton Icon="reload" OnClick="@RefreshDataAsync" />
                <GridButton Text="@CommonL["Btn_Add"]"
                            Icon="add" 
                    Toggle="modal" 
                    Target="@_genresFormDialogId" />
                <GridButton Text="Import" Icon="import" />
            </GridToolbar>
            <GridColumns>
                <GridColumn Title="@CommonL["Txt_Name"]" Field="g => g.Name" />
                <GridColumn Title="@CommonL["Txt_Active"]" Field="@(x => x.IsActive ? @CommonL["Txt_Yes"] : @CommonL["Txt_No"])" />
            </GridColumns>
            <GridRowActions Context="genre">
                <GridButton Icon="edit" Toggle="modal" Target="@_genresFormDialogId"
                            OnClick="@(() => SelectGenre(genre))" />
                <GridButton Icon="delete" Toggle="modal" Target="@_deleteGenreModalId"
                            OnClick="@(() => SelectGenreForDelete(genre))" />
            </GridRowActions>
        </DataGrid>
    </CardBody>
</AdminContentCard>

<GenreFormDialog Id="@_genresFormDialogId"
    Genre="@_selectedGenre"
    OnSuccess="@RefreshDataAsync"/>

<ConfirmDialog @ref="_deleteDialog"
               Id="@_deleteGenreModalId"
               OnSubmit="@DeleteGenreAsync"
               Text="@CommonL["Info_GenreDeleteConfirmation"]"
               IsSubmitting="@_isDeleting" />