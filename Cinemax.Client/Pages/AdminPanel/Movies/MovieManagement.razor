@using Cinemax.Client.Pages.Shared.AdminPanel
@using Cinemax.Client.Services
@using Cinemax.Shared.Contracts.Movies

@page "/admin/movies"
@attribute [Authorize(Roles = "Admin")]
@layout AdminPanelLayout

@inject HttpClient _httpClient
@inject NotificationService _notificationService

<AdminContentCard Title="@CommonL["Txt_Movies"]">
    <CardBody>
        <DataGrid @ref="_moviesGrid" TItem="MovieDto" LoadData="@LoadData">
            <GridToolbar>
                <GridButton Icon="reload" OnClick="@RefreshDataAsync" />
                <GridButton Text="Dodaj" 
                    Icon="add" 
                    Toggle="modal" 
                    Target="@_createMovieDialogId" />
                <GridButton Text="Import" Icon="import" />
            </GridToolbar>
            <GridColumns>
                <GridColumn Title="@CommonL["Label_Title"]" Field="m => m.Title" />
                <GridColumn Title="@CommonL["Label_Director"]" Field="m => m.Director" />
                <GridColumn Title="@CommonL["Txt_Description"]" Field="m => m.Description" />
                <GridColumn Title="@CommonL["Txt_Duration"]" Field="m => m.DurationMinutes" />
                <GridColumn Title="@CommonL["Txt_Active"]" Field="@(x => x.IsActive ? @CommonL["Txt_Yes"] : @CommonL["Txt_No"])" />
                <GridColumn Title="@CommonL["Txt_PosterUrl"]" Field="m => m.PosterUrl" />
                <GridColumn Title="@CommonL["Txt_TrailerUrl"]" Field="m => m.TrailerUrl" />
            </GridColumns>
            <GridRowActions Context="movie">
                <GridButton Icon="edit" Toggle="modal" Target="@_createMovieDialogId"
                            OnClick="@(() => SelectMovie(movie))" />
                <GridButton Icon="delete" Toggle="modal" Target="@_deleteMovieModalId"
                            OnClick="@(() => SelectMovieForDelete(movie))" />
            </GridRowActions>
        </DataGrid>
    </CardBody>
</AdminContentCard>

<MovieFormDialog Id="@_createMovieDialogId"
                 Movie="@_selectedMovie"
                 OnSuccess="@RefreshDataAsync"/>

<ConfirmDialog @ref="_deleteDialog"
               Id="@_deleteMovieModalId"
               OnSubmit="@DeleteMovieAsync"
               Text="@CommonL["Info_MovieDeleteConfirmation"]"
               IsSubmitting="@_isDeleting" />