@using Cinemax.Client.Services
@using Cinemax.Shared.Enums
@using Cinemax.Client.Pages.Shared.AdminPanel

@inject HttpClient _httpClient
@inject NotificationService _notificationService

<AdminFormDialog @ref="_form"
                 Id="@Id"
                 Title="@CommonL["Txt_ImportSeats"]"
                 Model="@_seats"
                 OnValidSubmit="@HandleCreateSeats"
                 OnCancel="@HandleCanel"
                 ErrorMessage="@_errorMessage"
                 Errors="@_errors"
                 IsSubmitting="@_isSubmitting">
    <Body>
        <div class="form-group mt-3">
            <label class="form-label">@CommonL["Txt_SelectImportFile"] (.xlsx):</label>
            <InputFile OnChange="@OnFileSelected" accept=".xlsx"></InputFile>
            <div class="alert-danger">
                <ValidationMessage For="(() => _seats.File)" />
            </div>
        </div>
    </Body>
</AdminFormDialog>
