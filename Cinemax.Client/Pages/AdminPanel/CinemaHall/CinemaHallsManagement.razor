@using Cinemax.Client.Pages.Shared.AdminPanel
@using Cinemax.Client.Services
@using Cinemax.Shared.Contracts.CinemaHalls

@page "/admin/cinemahalls"
@attribute [Authorize(Roles = "Admin")]
@layout AdminPanelLayout

@inject HttpClient _httpClient
@inject NotificationService _notificationService

<AdminContentCard Title="@CommonL["Txt_CinemaHalls"]">
    <CardBody>
        <DataGrid @ref="_cinemahallGrid" TItem="CinemaHallDto" LoadData="@LoadData">
            <GridToolbar>
                <GridButton Icon="reload" OnClick="@RefreshDataAsync" />
                <GridButton Text="@CommonL["Btn_Add"]" Icon="add" Toggle="modal" Target="@_createCinemahallModalId" />
            </GridToolbar>
            <GridColumns>
                <GridColumn Title="@CommonL["Txt_CinemaHallNumber"]" Field="x => x.Number" />
                <GridColumn Title="@CommonL["Txt_Type"]" Field="x => x.Type" />
                <GridColumn Title="@CommonL["Txt_SeatsCount"]" Field="x => x.SeatCount" />
                <GridColumn Title="@CommonL["Txt_Active"]" Field="@(x => x.IsActive ? @CommonL["Txt_Yes"] : @CommonL["Txt_No"])" />
            </GridColumns>
            <GridRowActions Context="cinemaHall">
                <GridButton Icon="edit" Text="@CommonL["Txt_Seats"]" Toggle="modal" Target="@_createSeatsModalId"
                            OnClick="@(() => SelectCinemaHall(cinemaHall))" />
                <GridButton Icon="edit" Toggle="modal" Target="@_createCinemahallModalId"
                            OnClick="@(() => SelectCinemaHall(cinemaHall))" />
                <GridButton Icon="delete" Toggle="modal" Target="@_deleteCinemahallModalId" 
                    OnClick="@(() => SelectCinemaHallForDelete(cinemaHall))" />
            </GridRowActions>
        </DataGrid>
    </CardBody>
</AdminContentCard>

<CinemaHallFormDialog Id="@_createCinemahallModalId"
                      Hall="@_selectedCinemaHall"
                      OnSuccess="@RefreshDataAsync" />

<CreateSeatsFormDialog Id="@_createSeatsModalId"
                       CinemaHallId="@_selectedCinemaHall?.Id"
                       OnCreated="@RefreshDataAsync" />

<ConfirmDialog @ref="_deleteDialog" 
               Id="@_deleteCinemahallModalId"
               OnSubmit="@DeleteCinemaHallAsync" 
               Text="@CommonL["Info_CinemaHallDeleteConfirmation"]"
               IsSubmitting="@_isDeleting"/>



