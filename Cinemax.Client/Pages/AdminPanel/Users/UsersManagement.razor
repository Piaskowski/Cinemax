@using Cinemax.Client.Pages.Shared
@using Cinemax.Client.Pages.Shared.AdminPanel
@using Cinemax.Client.Services
@using Cinemax.Shared.Contracts.Identity
@using Cinemax.Shared.Resources.Auth

@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@layout AdminPanelLayout

@inject HttpClient _httpClient
@inject NotificationService _notificationService
@inject IStringLocalizer<AuthMessages> _authL

<AdminContentCard Title="@CommonL["Txt_Users"]">
    <CardBody>
        <DataGrid @ref="_userGrid" TItem="UserDto" LoadData="@LoadData">
            <GridToolbar>
                <GridButton Icon="reload" OnClick="@RefreshDataAsync"/>
                <GridButton Text="@CommonL["Btn_Add"]" Icon="add" Toggle="modal" Target="@_createUserDialogId" />
            </GridToolbar>
            <GridColumns>
                <GridColumn Title="@_authL["Label_FirstName"]" Field="u => u.FirstName" />
                <GridColumn Title="@_authL["Label_LastName"]" Field="u => u.LastName" />
                <GridColumn Title="@_authL["Label_Email"]" Field="u => u.Email" />
                <GridColumn Title="@_authL["Txt_Role"]" Field="u => u.Role" />
                <GridColumn Title="@CommonL["Txt_Active"]" Field="u => u.IsActive" />
                <GridColumn Title="@CommonL["Txt_CreatedAt"]" Field="u => u.CreatedAt" />
                <GridColumn Title="@CommonL["Txt_ModifiedAt"]" Field="u => u.ModifiedAt" />
                <GridColumn Title="@CommonL["Txt_ModifiedBy"]" Field="u => u.ModifiedBy" />
            </GridColumns>
            <GridRowActions Context="user">
                <GridButton Icon="edit" Toggle="modal" Target="@_createUserDialogId"
                            OnClick="@(() => SelectUser(user))" />
                <GridButton Icon="delete" Toggle="modal" Target="@_deleteUserModalId"
                            OnClick="@(() => SelectUserForDelete(user))" />
            </GridRowActions>
        </DataGrid>
    </CardBody>
</AdminContentCard>

<UserFormDialog Id="@_createUserDialogId"
                User="@_selectedUser"     
                OnCreated="@RefreshDataAsync" />

<ConfirmDialog @ref="_deleteDialog"
               Id="@_deleteUserModalId"
               OnSubmit="@DeleteUserAsync"
               Text="@CommonL["Info_UserDeleteConfirmation"]"
               IsSubmitting="@_isDeleting" />

