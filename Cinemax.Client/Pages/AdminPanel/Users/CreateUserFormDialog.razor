@using Cinemax.Client.Pages.Shared
@using Cinemax.Client.Pages.Shared.AdminPanel
@using Cinemax.Client.Services
@using Cinemax.Shared.Enums

@inject HttpClient HttpClient
@inject IStringLocalizer<CommonMessages> CommonL
@inject NotificationService NotificationService

<AdminFormDialog @ref="_form"
    Id="@Id" 
    Model="@_user"
    OnValidSubmit="@CreateUserHandler" 
    OnCancel="@Cancelhandler" 
    Title="Dodaj użytkownika"
    ErrorMessage="@_errorMessage"
    Errors="@_errors"
    IsSubmitting="@_isSubmitting">
    <Body>
        <div class="form-group mt-3">
            <label class="form-label">Imię:</label>
            <InputText @bind-Value="@_user.FirstName" class="form-control"></InputText>
            <div class="alert-danger">
                <ValidationMessage For="(() => _user.FirstName)" />
            </div>
        </div>
        <div class="form-group mt-3">
            <label class="form-label">Nazwisko:</label>
            <InputText class="form-control" @bind-Value="@_user.LastName"></InputText>
            <div class="alert-danger">
                <ValidationMessage For="(() => _user.LastName)" />
            </div>
        </div>
        <div class="form-group mt-3">
            <label class="form-label">Email:</label>
            <InputText class="form-control" @bind-Value="@_user.Email"></InputText>
            <div class="alert-danger">
                <ValidationMessage For="(() => _user.Email)" />
            </div>
        </div>
        <div class="form-group mt-3">
            <label class="form-label">Rola:</label>
            <InputSelect class="form-select" @bind-Value="@_user.Role">
                @foreach (var role in Enum.GetValues<UserRole>())
                {
                    <option value="@role">@role</option>
                }
            </InputSelect>
            <div class="alert-danger">
                <ValidationMessage For="(() => _user.Role)" />
            </div>
        </div>
    </Body>
</AdminFormDialog>
