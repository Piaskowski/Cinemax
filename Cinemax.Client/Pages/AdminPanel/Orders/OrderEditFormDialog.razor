@using Cinemax.Client.Pages.Shared.AdminPanel
@using Cinemax.Client.Services
@using Cinemax.Shared.Enums

@inject HttpClient _httpClient
@inject NotificationService _notificationService

<AdminFormDialog @ref="_form"
                 Id="@Id"
                 Model="@OrderModel"
                 OnValidSubmit="@OnValidSubmit"
                 OnCancel="@HandleCancel"
                 Title="@_title"
                 ErrorMessage="@_errorMessage"
                 Errors="@_errors"
                 IsSubmitting="@_isSubmitting">
    <Body>
        <h5 class="mb-3">Dane zamówienia</h5>

        <div class="row mb-4">
            <div class="col-md-6 mb-3">
                <div class="text-muted small">@CommonL["Txt_OrderNumber"]</div>
                <div class="fw-semibold">@OrderModel.Id</div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="text-muted small">@CommonL["Txt_Customer"]</div>
                <div class="fw-semibold">
                    @(string.IsNullOrWhiteSpace(OrderModel.CustomerEmail)
                                        ? CommonL["Txt_NoEmail"]
                                        : OrderModel.CustomerEmail)
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="text-muted small">@CommonL["Txt_CreatedAt"]</div>
                <div class="fw-semibold">
                    @OrderModel.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                </div>
            </div>

            <div class="col-md-6 mb-3">
                <div class="text-muted small">@CommonL["Txt_Screening"]</div>
                <div class="fw-semibold">
                    @OrderModel.ScreeningDate.ToString("dd.MM.yyyy HH:mm")
                </div>
            </div>


            <div class="col-md-3 mb-3">
                <div class="text-muted small">@CommonL["Txt_Total"]</div>
                <div class="fw-semibold">
                    @OrderModel.TotalPrice.ToString("0.00") @CommonL["Txt_Pln"]
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(OrderModel.CreatedByUserEmail))
            {
                <div class="col-md-6 mb-3">
                    <div class="text-muted small">@CommonL["Txt_CreatedBy"]</div>
                    <div class="fw-semibold">@OrderModel.CreatedByUserEmail</div>
                </div>
            }
        </div>

        <hr />
        <div class="form-group mb-4">
            <label class="form-label">@CommonL["Txt_OrderStatus"]:</label>
            <InputSelect disabled="@(!OrderModel.CanEditStatus)" class="form-select" @bind-Value="OrderModel.Status">
                @foreach(var option in Enum.GetValues<OrderStatus>())
                {
                    <option value="@option">@option</option>
                }
            </InputSelect>
        </div>
        <hr/>
        <h5 class="mb-4">@CommonL["Txt_Reservations"]</h5>
        @foreach(var reservation in OrderModel.Reservations)
        {
            <div class="reservation-row">
                <div class="reservation-details">
                    <span>@CommonL["Txt_Row"] @reservation.Row, @CommonL["Txt_SeatNumber"] @reservation.SeatNum</span>
                    <span>@CommonL["Txt_SeatType"]: @reservation.SeatType</span>
                    <span>@CommonL["Txt_TicketType"]: @reservation.TicketType</span>
                </div>
                <div class="reservation status">
                    <InputSelect class="form-select"
                                 disabled="@(!OrderModel.CanEditStatus || !reservation.CanEditStatus)"
                                 @bind-Value="reservation.Status">

                        @foreach (var option in Enum.GetValues<ReservationStatus>())
                        {
                            <option value="@option">@option</option>
                        }

                    </InputSelect>
                </div>
            </div>
        }
    </Body>
</AdminFormDialog>

