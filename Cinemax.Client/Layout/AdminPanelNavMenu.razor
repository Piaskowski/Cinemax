        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/users" Match="NavLinkMatch.All">
                <i class="bi bi-people nav-icon" aria-hidden="true"></i> Użytkownicy
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="admin/screenings">
