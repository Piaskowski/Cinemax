@using Microsoft.AspNetCore.Components.Authorization

@inherits LayoutComponentBase

@inject HttpClient HttpClient
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<div class="page">
    <main>
        <div class="top-row px-4">
            <div class="container">
                <div class="row">
                    <div class="top-row-nav">
                        <a href="/">
                            <img src="images/cinemax-logo2.png"
                                 alt="Cinemax — home"
                                 class="navbar-logo" />
                        </a>
                        <a href="/screenings">
                            <i class="bi bi-calendar4-week gold-gradient"></i>
                            Repertuar
                        </a>
                        <a href="">
                            <i class="bi bi-film gold-gradient"></i>
                            Filmy
                        </a>
                        <a href="">
                            <i class="bi bi-envelope gold-gradient"></i>
                            Kontakt
                        </a>
                        <span class="nav-separator"></span>
                        <AuthorizeComponent />
                    </div>
                </div>
            </div>
        </div>

        <article class="content px-4">
            @Body
        </article>
        <div>
            <Footer />
        </div>
    </main>
</div>
